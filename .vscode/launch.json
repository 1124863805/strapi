{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Leao Develop (Debug)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/packages/core/leao/bin/leao.js",
      "args": ["develop"],
      "cwd": "${workspaceFolder}",
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal",
      "env": {
        "NODE_ENV": "development"
      }
    },
    {
      "name": "Leao Develop (Debug + Break on Start)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/packages/core/leao/bin/leao.js",
      "args": ["develop"],
      "cwd": "${workspaceFolder}",
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal",
      "env": {
        "NODE_ENV": "development"
      },
      "stopOnEntry": true
    }
  ]
}
