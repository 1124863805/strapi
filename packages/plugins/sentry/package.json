{
  "name": "@leao/plugin-sentry",
  "version": "5.0.6",
  "description": "Send Leao error events to Sentry",
  "repository": {
    "type": "git",
    "url": "https://github.com/leao/leao.git",
    "directory": "packages/plugins/sentry"
  },
  "license": "UNLICENSED",
  "author": {
    "name": "Leao Solutions SAS",
    "email": "hi@leao.io",
    "url": "https://leao.io"
  },
  "maintainers": [
    {
      "name": "Leao Solutions SAS",
      "email": "hi@leao.io",
      "url": "https://leao.io"
    }
  ],
  "exports": {
    "./leao-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./leao-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "./dist",
    "leao-server.js"
  ],
  "scripts": {
    "build": "leao-plugin build",
    "clean": "run -T rimraf dist",
    "lint": "run -T eslint .",
    "watch": "leao-plugin watch"
  },
  "dependencies": {
    "@leao/design-system": "workspace:*",
    "@leao/icons": "workspace:*",
    "@sentry/node": "7.112.2"
  },
  "devDependencies": {
    "@leao/leao": "workspace:*",
    "@leao/pack-up": "workspace:*",
    "@leao/sdk-plugin": "workspace:*",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.22.3",
    "styled-components": "6.1.8"
  },
  "peerDependencies": {
    "@leao/leao": "^5.0.0 || ^5.0.0-beta || ^5.0.0-alpha || ^5.0.0-rc",
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0",
    "react-router-dom": "^6.0.0",
    "styled-components": "^6.0.0"
  },
  "engines": {
    "node": ">=18.0.0 <=22.x.x",
    "npm": ">=6.0.0"
  },
  "leao": {
    "name": "sentry",
    "displayName": "Sentry",
    "description": "Send Leao error events to Sentry.",
    "kind": "plugin"
  }
