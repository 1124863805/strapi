    {
      "name": "Leao Solutions SAS",
      "email": "hi@leao.io",
      "url": "https://leao.io"
    }
  ],
  "exports": {
    "./leao-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./leao-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "leao-server.js"
  ],
  "scripts": {
    "build": "pack-up build",
    "clean": "run -T rimraf ./dist",
    "lint": "run -T eslint .",
    "watch": "pack-up watch"
  },
  "dependencies": {
    "@leao1/design-system": "^1.0.0",
    "@leao1/generators": "^1.0.0",
    "@leao1/icons": "^1.0.0",
    "@leao1/utils": "^1.0.0",
    "@reduxjs/toolkit": "1.9.7",
    "@sindresorhus/slugify": "1.1.0",
    "date-fns": "2.30.0",
    "fs-extra": "11.2.0",
    "immer": "9.0.21",
    "lodash": "4.17.21",
    "pluralize": "8.0.0",
    "qs": "6.11.1",
    "react-intl": "6.6.2",
    "react-redux": "8.1.3",
    "yup": "0.32.9"
  },
  "devDependencies": {
    "@leao1/admin": "^1.0.0",
    "@leao1/pack-up": "^1.0.0",
    "@leao1/types": "^1.0.0",
    "@types/fs-extra": "11.0.4",
    "@types/pluralize": "0.0.30",
    "@types/react-dom": "^19.2.3",
    "koa": "2.15.2",
    "koa-body": "6.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-query": "3.39.3",
    "react-router-dom": "6.22.3",
    "styled-components": "6.1.8"
  },
  "peerDependencies": {
    "@leao1/admin": "^1.0.0",
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0",
    "react-router-dom": "^6.0.0",
    "styled-components": "^6.0.0"
  },
  "engines": {
    "node": ">=18.0.0 <=22.x.x",
    "npm": ">=6.0.0"
  },
  "leao": {
    "name": "content-type-builder",
    "displayName": "Content Type Builder",
    "description": "Modelize the data structure of your API. Create new fields and relations in just a minute. The files are automatically created and updated in your project.",
    "kind": "plugin",
    "required": true
  }
}
