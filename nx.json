{
  "namedInputs": {
    "default": ["{projectRoot}/**/*"],
    "production": [
      "default",
      "!{projectRoot}/**/*.test.*",
      "!{projectRoot}/**/__tests__/**",
      "!{projectRoot}/**/__mocks__/**",
      "!{projectRoot}/**/node_modules/**",
      "!{projectRoot}/**/dist/**"
    ]
  },
  "cli": { "packageManager": "yarn" },
  "targetDefaults": {
    "build": {
      "inputs": ["production", "^production"],
      "dependsOn": ["^build"],
      "cache": true
    }
  },
  "useInferencePlugins": false
}
