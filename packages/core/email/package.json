      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "leao-server.js"
  ],
  "scripts": {
    "build": "pack-up build",
    "clean": "run -T rimraf ./dist",
    "lint": "run -T eslint .",
    "watch": "pack-up watch"
  },
  "dependencies": {
    "@leao1/design-system": "^1.0.0",
    "@leao1/icons": "^1.0.0",
    "@leao1/provider-email-sendmail": "^1.0.0",
