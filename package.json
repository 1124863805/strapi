{
  "name": "strapi",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*",
    "packages/*/*",
    "examples/*",
    "examples/*/src/plugins/*"
  ],
  "scripts": {
    "build": "nx run-many --target=build --nx-ignore-cycles",
    "build:app": "cd examples/getstarted && yarn build",
    "dev": "cd examples/getstarted && yarn develop",
    "start": "cd examples/getstarted && yarn start",
    "clean": "nx run-many --target=clean --nx-ignore-cycles"
  },
  "resolutions": {
    "@types/koa": "2.13.4"
  },
  "devDependencies": {
    "@babel/core": "^7.20.12",
    "@babel/eslint-parser": "^7.25.1",
    "@babel/preset-react": "7.18.6",
    "@strapi/eslint-config": "0.2.0",
    "@swc/cli": "0.3.10",
    "@swc/core": "1.4.8",
    "@swc/helpers": "0.5.7",
    "create-strapi-app": "workspace:*",
    "eslint": "8.50.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^17.1.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "3.6.1",
    "eslint-plugin-check-file": "2.6.2",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "nx": "18.2.2",
    "plop": "2.7.6",
    "rimraf": "5.0.5",
    "typescript": "5.3.2"
  },
  "packageManager": "yarn@4.5.0",
  "engines": {
    "node": ">=18.0.0 <=22.x.x",
    "npm": ">=6.0.0"
  },
  "isStrapiMonorepo": true
}
